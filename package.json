    "smoke:prompts": "node --import tsx scripts/smoke-default-prompts.ts",
    "smoke:writer-init": "node --import tsx scripts/smoke-writer-init.ts",
    "smoke:ai-scope": "node --import tsx scripts/smoke-ai-request-scope.ts",
