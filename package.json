    "ai": "^7.0.91",
    "element-plus": "^2.14.5",
    "mammoth": "^1.12.2",
    "marked": "^18.0.11",
    "mind-elixir": "^4.3.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
