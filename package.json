    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,json}\"",
    "smoke:ai": "node --import tsx scripts/smoke-ai-sdk.ts",
    "smoke:compactor": "node --import tsx scripts/smoke-context-compactor.ts",
