{
  "name": "llm-writer",
  "version": "1.0.0",
  "description": "AI智能小说创作工具（纯前端）",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,json}\"",
    "smoke:ai": "tsx scripts/smoke-ai-sdk.ts",
    "smoke:compactor": "tsx scripts/smoke-context-compactor.ts",
    "smoke:persistence": "tsx scripts/smoke-novel-persistence.ts",
    "smoke:corpus": "tsx scripts/smoke-corpus-retrieval.ts",
    "smoke:mindmap": "tsx scripts/smoke-mindmap-data.ts",
    "smoke:eventline": "tsx scripts/smoke-event-line.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.101",
    "@ai-sdk/google": "^2.0.95",
    "@ai-sdk/openai-compatible": "^1.0.53",
    "@element-plus/icons-vue": "^2.3.2",
    "@mind-elixir/export-mindmap": "^0.1.10",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "ai": "^5.0.251",
    "element-plus": "^2.14.5",
    "marked": "^18.0.11",
    "mind-elixir": "^4.3.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
