    "smoke:writer-continue": "node --import tsx scripts/smoke-writer-continue.ts",
    "smoke:writer-optimize": "node --import tsx scripts/smoke-writer-optimize.ts",
    "smoke:writer-prompts": "node --import tsx scripts/smoke-writer-prompts.ts",
    "smoke:writer-prompt-orchestration": "node --import tsx scripts/smoke-writer-prompt-orchestration.ts",
    "smoke:bundle": "node --import tsx scripts/smoke-bundle.ts",
